<?xml version="1.0" encoding="UTF-8"?>
<Config>
	<Device>

		<!-- Время перемещения рукоятки контроллера на 1% тягового/тормозного сектора, с -->
		<handle_motion_time>0.1</handle_motion_time>

		<!-- Коэффициент ускорения контроллера с нажатым Shift -->
